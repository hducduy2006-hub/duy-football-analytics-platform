{
    "name": "Spark Dev Container",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "spark-client",
    "workspaceFolder": "/opt/spark-apps",
    "shutdownAction": "none",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/bitnami/python/bin/python3"
            }
        }
    }
}
